# Copy this file to .env and replace deployment secrets before publishing.
MYSQL_DATABASE=language_school
MYSQL_USER=language_school
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
APP_SECURITY_JWT_SECRET=replace-with-at-least-32-random-utf8-bytes

# Optional host port overrides.
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=80
